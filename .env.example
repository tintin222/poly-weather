# Database
DB_PATH=./data/poly_weather.db

# Polymarket credentials (required for trading)
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_SIGNATURE_TYPE=0  # 0=EOA, 1=POLY_PROXY

# Trading settings
PAPER_MODE=true
MAX_BET_SIZE=50.0
MAX_DAILY_EXPOSURE=200.0
MIN_CONFIDENCE=0.85
MIN_EXPECTED_VALUE=0.03

# Polling intervals (minutes)
WEATHER_POLL_INTERVAL_MINUTES=30
MARKET_POLL_INTERVAL_MINUTES=5

# Active cities (comma-separated)
ACTIVE_CITIES=Ankara

# Logging
LOG_LEVEL=INFO
